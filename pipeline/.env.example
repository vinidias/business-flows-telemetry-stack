# ==============================================================================
# Database Source Configuration (MySQL or PostgreSQL)
# ==============================================================================
DB_DRIVER=mysql          # Supported options: 'mysql' or 'postgresql'
DB_HOST=your-database-host
DB_PORT=3306             # Default: 3306 (MySQL) or 5432 (PostgreSQL)
DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password

# Optional: Comma-separated list of tables to extract
DB_TABLES=users,analytics_events,transactions

# ==============================================================================
# Local Storage & OLAP Engine (DuckDB / Parquet)
# ==============================================================================
DUCKDB_PATH=./analytics.duckdb
RAW_DATA_PATH=./data/raw

# ==============================================================================
# Grafana Cloud Telemetry Sink (Prometheus API)
# ==============================================================================
# Obtain in Grafana Cloud Portal: My Account > Prometheus > Details
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/v1/push
GRAFANA_INSTANCE_ID=your_instance_id
GRAFANA_API_KEY=your_api_key
